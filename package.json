{
  "name": "nfr-workos",
  "version": "1.0.0",
  "private": true,
  "description": "NFR WorkOS: Live the NFR Day. One work environment for non-financial risk, with specialist intelligence per function and human accountability at every material decision.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:accessibility": "playwright test tests/e2e/accessibility.spec.ts",
    "test:keyboard": "playwright test tests/e2e/keyboard.spec.ts",
    "perf:check": "tsx scripts/perf-check.ts",
    "lint": "eslint src/ app/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ app/ --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "check:copy": "node scripts/check-no-emdash.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "demo:reset": "tsx scripts/reset.ts",
    "demo:safe": "cross-env NFR_DEMO_MODE=safe next dev -p 3000",
    "demo:live": "cross-env NFR_DEMO_MODE=live next dev -p 3000",
    "export:deck": "tsx scripts/export-deck.ts",
    "db:generate": "drizzle-kit generate",
    "eval": "tsx scripts/evaluate.ts",
    "eval:structural": "tsx scripts/eval-runner.ts --mode=structural",
    "eval:grounding": "tsx scripts/eval-runner.ts --mode=grounding",
    "eval:live": "tsx scripts/eval-runner.ts --mode=live",
    "eval:golden": "tsx scripts/eval-runner.ts --mode=golden",
    "eval:release": "tsx scripts/eval-runner.ts --mode=release",
    "verify:config": "tsx scripts/verify-config.ts",
    "verify:data": "tsx scripts/verify-data.ts",
    "verify:processes": "tsx scripts/verify-processes.ts",
    "verify:audit": "tsx scripts/verify-audit.ts",
    "verify:identity": "tsx scripts/verify-identity.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "smoke:live": "cross-env NFR_DEMO_MODE=live tsx scripts/smoke-live.ts",
    "verify:seed": "tsx scripts/verify-seed-depth.ts",
    "capture:v1": "node scripts/capture-screens.mjs v1",
    "capture:v2": "node scripts/capture-screens.mjs v2",
    "build:verify": "cross-env NFR_DIST_DIR=.next-verify next build",
    "audit:verify-chain": "tsx scripts/verify-chain.ts",
    "support:bundle": "tsx scripts/support-bundle.ts",
    "worker": "tsx scripts/worker.ts",
    "dev:all": "tsx scripts/dev-all.ts",
    "backup:create": "tsx scripts/backup.ts create",
    "backup:verify": "tsx scripts/backup.ts verify",
    "backup:restore": "tsx scripts/backup.ts restore",
    "test:recovery": "vitest run tests/integration/recovery.test.ts",
    "test:migration": "tsx scripts/test-migration.ts",
    "sbom": "tsx scripts/sbom.ts",
    "licenses": "tsx scripts/licenses.ts",
    "release:package": "tsx scripts/release-package.ts",
    "pilot:evidence-pack": "tsx scripts/evidence-pack.ts",
    "audit:all": "npm run typecheck && npm run lint && npm run check:copy && npm run scan:secrets && npm run test:unit && npm run test:integration && npm run eval:structural"
  },
  "dependencies": {
    "@openai/agents": "0.18.0",
    "@tabler/icons-react": "3.48.0",
    "@xyflow/react": "12.12.0",
    "better-sqlite3": "13.0.3",
    "d3": "7.9.0",
    "drizzle-orm": "0.45.3",
    "elkjs": "0.12.0",
    "geist": "^1.7.2",
    "motion": "13.4.6",
    "next": "16.3.7",
    "openai": "7.25.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "^9.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/d3": "7.4.3",
    "@types/node": "22.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "pptxgenjs": "4.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
