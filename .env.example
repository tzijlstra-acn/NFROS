# NFR WorkOS local configuration example.
# Never place a real API key in this file. It is committed.

# Demo mode: live | safe | offline
NFR_DEMO_MODE=safe

# Paths to the read-only source repositories.
# The OpenAI key is read from REAL_AI_INFRA_PATH at runtime and is never copied here.
REAL_AI_INFRA_PATH=../RealAIInfrastructure
NFR_PITCH_SOURCE_PATH=../NFRPitch
# Optional single root to search when the two paths above are not set.
NFR_SOURCE_ROOT=

# Model configuration. Leave blank to use the documented preference list.
OPENAI_MODEL_PRIMARY=
OPENAI_MODEL_FAST=
OPENAI_MODEL_DEEP=
OPENAI_REALTIME_MODEL=
OPENAI_EMBEDDING_MODEL=
